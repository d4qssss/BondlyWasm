
@page "/marchzins"


<h1>Marchzins Rechner</h1>

<div @key="formularVersion" class="d-flex flex-column gap-2" style="max-width: 350px;">
    <label>
        Kaufdatum
        <input class="form-control" type="text" placeholder="DD.MM.YYYY" @bind:get="kaufdatumText" @bind:set="text => DatumEingeben(ref kaufdatumText, text)"
               @bind:event="oninput" />
    </label>

    <label>
        Verkaufsdatum
        <input class="form-control" type="text" placeholder="DD.MM.YYYY" @bind:get="verkaufsdatumText" @bind:set="text => DatumEingeben(ref verkaufsdatumText, text)"
               @bind:event="oninput" />
    </label>

    <label>
        Kapital in CHF
        <input class="form-control" type="number" step="any" @bind="kapital"
               @bind:event="oninput" @bind:after="Berechnen" />
    </label>

    <label>
        Zinssatz in %
        <input class="form-control" type="number" step="any" @bind="zinssatz"
               @bind:event="oninput" @bind:after="Berechnen" />
    </label>
</div>

<details class="my-3">
    <summary aria-label="Wie wurde der Marchzins berechnet?" title="Wie wurde das berechnet?">ⓘ</summary>
    <p>Marchzins = Kapital × (Zinssatz ÷ 100) × Tage ÷ 360.</p>
    <p>Die Tage ergeben sich aus der Differenz zwischen Verkaufsdatum und Kaufdatum.</p>
</details>

<p role="status">@ergebnis</p>

<button type="button" class="btn btn-outline-secondary" @onclick="Zuruecksetzen">Zurücksetzen</button>
@if (exportText is not null)
{
    <a class="btn btn-primary" href="@("data:text/plain;charset=utf-8," + Uri.EscapeDataString(exportText))"
       download="marchzins.txt">Exportieren</a>
}
else
{
    <button type="button" class="btn btn-primary" disabled>Exportieren</button>
}

@code {
    string kaufdatumText = "";
    string verkaufsdatumText = "";
    double? kapital;
    double? zinssatz;

    int formularVersion;
    string ergebnis = "";
    string? exportText;

    void Zuruecksetzen()
    {
        formularVersion++;
        kaufdatumText = "";
        verkaufsdatumText = "";
        kapital = null;
        zinssatz = null;
        Berechnen();
    }

    void DatumEingeben(ref string datumText, string? eingabe)
    {
        var datum = new System.Text.StringBuilder();
        int abschnitt = 0;
        int ziffern = 0;

        foreach (char zeichen in eingabe ?? string.Empty)
        {
            if (zeichen == '.' && abschnitt < 2 && ziffern > 0)
            {
                if (ziffern == 1)
                {
                    datum.Insert(datum.Length - 1, '0');
                }

                datum.Append('.');
                abschnitt++;
                ziffern = 0;
            }
            else if (char.IsAsciiDigit(zeichen))
            {
                if (abschnitt < 2 && ziffern == 2)
                {
                    datum.Append('.');
                    abschnitt++;
                    ziffern = 0;
                }

                if (abschnitt == 2 && ziffern == 4)
                {
                    break;
                }

                datum.Append(zeichen);
                ziffern++;
            }
        }

        datumText = datum.ToString();
        Berechnen();
    }

    bool DatumLesen(string text, out DateTime datum)
    {
        return DateTime.TryParseExact(text, "dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out datum);
    }

    void Berechnen()
    {
        ergebnis = "";
        exportText = null;

        if (kaufdatumText.Length < 10 || verkaufsdatumText.Length < 10)
        {
            return;
        }

        if (!DatumLesen(kaufdatumText, out DateTime kaufdatum)
            || !DatumLesen(verkaufsdatumText, out DateTime verkaufsdatum))
        {
            ergebnis = "Bitte gültige Daten im Format DD.MM.YYYY eingeben.";
            return;
        }

        if (kapital is null || zinssatz is null)
        {
            return;
        }

        if (kaufdatum >= verkaufsdatum)
        {
            ergebnis = "Das Verkaufsdatum muss nach dem Kaufdatum sein.";
        }
        else if (kapital <= 0)
        {
            ergebnis = "Das Kapital muss grösser als 0 sein.";
        }
        else if (zinssatz < 0)
        {
            ergebnis = "Der Zinssatz darf nicht negativ sein.";
        }
        else
        {
            int tage = (verkaufsdatum - kaufdatum).Days;

            double zins = zinssatz.Value / 100;

            double marchzins = kapital.Value * zins * tage / 360;

            if (!double.IsFinite(marchzins))
            {
                ergebnis = "Das Ergebnis liegt ausserhalb des berechenbaren Bereichs.";
                return;
            }

            ergebnis = "Marchzins: " + Math.Round(marchzins, 2) + " CHF";
            exportText = $"""
                BONDLY – Marchzins Rechner
                Kaufdatum: {kaufdatum:dd.MM.yyyy}
                Verkaufsdatum: {verkaufsdatum:dd.MM.yyyy}
                Kapital: {kapital} CHF
                Zinssatz: {zinssatz} %
                Tage: {tage}

                {ergebnis}
                """;
        }
    }
}

